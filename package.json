{
  "name": "printo-workspace",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "customer",
    "shops"
  ],
  "scripts": {
    "dev": "npm --prefix customer run dev",
    "dev:customer": "npm --prefix customer run dev",
    "dev:shops": "npm --prefix shops run dev",
    "build": "npm --prefix customer run build && npm --prefix shops run build",
    "build:customer": "npm --prefix customer run build",
    "build:shops": "npm --prefix shops run build",
    "preview:customer": "npm --prefix customer run preview",
    "preview:shops": "npm --prefix shops run preview"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
